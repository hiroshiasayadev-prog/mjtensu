# Non-secret MLDB v2 operational defaults for the current ClearML deployment.
# Merge these lines into a local .env; do not commit credentials or the actual .env.
# Explicit process environment overrides .env in mldb.cmd.
MLDB_V2_DEFAULT_BACKEND=clearml
MLDB_V2_CLEARML_QUEUE=default
MLDB_V2_CLEARML_DOCKER_GPU=all
MLDB_V2_CLEARML_PREBUILT_RUNTIME=true
MLDB_V2_RUNTIME_REGISTRY_URL=https://mjtensu-dev.home.arpa/mldb-runtime-registry/
MLDB_V2_CLEARML_RUNTIME_IMAGE_PROFILE=gpu-cu124
# CPU inherits the global Registry image profile, but receives no GPU devices.
# Only device-specific iPhone routes opt out of Registry image materialization.
MLDB_V2_CLEARML_STAGE_ROUTES_JSON={"onnx-cpu-latency":{"queue":"latency-cpu","docker_gpu":null},"ort-web-iphone-latency":{"queue":"latency-iphone","docker_gpu":null,"runtime_image_profile":null},"recognition-e2e-iphone":{"queue":"latency-iphone","docker_gpu":null,"runtime_image_profile":null},"recognition-iphone-latency":{"queue":"latency-iphone","docker_gpu":null,"runtime_image_profile":null},"recognition-functional-video":{"queue":"recognition-functional","docker_gpu":"all"}}
